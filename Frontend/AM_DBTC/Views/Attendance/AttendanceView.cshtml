@model AM_DBTC.Models.AttendanceModel
@{
    Layout = "_AttendanceLayout";
}

@* @section Styles {
    <link rel="stylesheet" href="~/css/Attendance.css" />
} *@

<div class="attendance-container">

    @* header *@
    <div class="attendance-header">
        <h1>Attendance</h1>
    </div>

    @* filter card *@
    <div class="attendance-search-card">
        <form method="get"
              asp-action="AttendanceView"
              asp-controller="Attendance"
              class="attendance-search-form">

            @* search *@
            <input type="text"
                   name="userName"
                   class="attendance-search-input"
                   placeholder="Search by Student Name"
                   value="@Context.Request.Query["userName"]" />

            @* courses *@
            <select name="course" class="attendance-select">
                @foreach (var c in Model.Courses)
                {
                    <option value="@c" selected="@(Model.SelectedCourse == c ? "selected" : null)">
                        @c
                    </option>
                }
            </select>

            @* months *@
            <select name="month" class="attendance-select">
                @foreach (var m in Model.Months)
                {
                    <option value="@m" selected="@(Model.SelectedMonth == m ? "selected" : null)">
                        @m
                    </option>
                }
            </select>

            @* filter button *@
            <button type="submit" class="attendance-search-btn">
                Filter
            </button>

        </form>
    </div>

    @* summary cards *@
    <div class="summary-cards">

        @* total classes *@
        <div class="summary-card total-card">
            <h2>@Model.TotalClasses</h2>
            <p>total classes held</p>
        </div>

        @* present classes *@
        <div class="summary-card present-card">
            <h2>@Model.ClassesPresent</h2>
            <p>classes present</p>
        </div>

        @* absent classes *@
        <div class="summary-card absent-card">
            <h2>@Model.ClassesAbsent</h2>
            <p>classes absent</p>
        </div>

    </div>

    @* attendance table *@
    <div class="attendance-card">

        @* table title *@
        <h2 class="attendance-title">Attendance Records</h2>

        <table class="attendance-table">

            @* table header *@
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Date</th>
                    <th>Day</th>
                    <th>Status</th>
                    <th>Time</th>
                    <th>Course</th>
                </tr>
            </thead>

            <tbody>

                @* empty state *@
                @if (Model.Records.Count == 0)
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding:30px; color:gray;">
                            No Records Found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var record in Model.Records)
                    {
                        var status = record.Status?.ToLower() ?? "";

                        <tr>

                            <td>@record.UserName</td>

                            @* date *@
                            <td>@record.Date.ToString("M/d")</td>

                            <td>@record.Day</td>

                            @* status *@
                            <td>
                                @{
                                    var statusClass = status switch
                                    {
                                        "present" => "present",
                                        "absent" => "absent",
                                        "leave" => "leave",
                                        _ => ""
                                    };

                                    var statusIcon = status switch
                                    {
                                        "present" => "✓ ",
                                        "absent" => "✕ ",
                                        "leave" => "◴ ",
                                        _ => ""
                                    };
                                }

                                <span class="status @statusClass">
                                    @statusIcon@record.Status
                                </span>
                            </td>

                            <td>@record.Time</td>

                            <td class="course-name">@record.Course</td>

                        </tr>
                    }
                }

            </tbody>

        </table>

        @* pagination *@
        <div class="pagination">
            <a class="page-btn @(Model.CurrentPage == 1 ? "disabled" : "")"
               href="@Url.Action("AttendanceView", new { userName = Context.Request.Query["userName"], course = Model.SelectedCourse, month = Model.SelectedMonth, page = Model.CurrentPage - 1 })">
                &lt; Previous
            </a>

            <span class="page-number">
                Page @Model.CurrentPage of @Model.TotalPages
            </span>

            <a class="page-btn @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")"
               href="@Url.Action("AttendanceView", new { userName = Context.Request.Query["userName"], course = Model.SelectedCourse, month = Model.SelectedMonth, page = Model.CurrentPage + 1 })">
                Next &gt;
            </a>
        </div>