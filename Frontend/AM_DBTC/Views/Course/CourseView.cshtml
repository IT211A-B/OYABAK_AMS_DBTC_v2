@model AM_DBTC.Models.CourseModel
@{
    Layout = "_CourseLayout";
}

@* @section Styles {
    <link rel="stylesheet" href="~/css/Course.css" />
} *@

<div class="course-container">

    @* header *@
    <div class="course-header">
        <h1>Course Management</h1>
        <button class="add-course-btn" onclick="openAddModal()">ADD COURSE</button>
    </div>

    @* filter card *@
    <div class="course-filter-card">
        <form method="get"
              asp-action="CourseView"
              asp-controller="Course"
              class="course-filter-form">

            <input class="course-search"
                   type="text"
                   placeholder="Search Course Code or Name" />

            <select name="semester" class="course-select">
                @foreach (var s in Model.Semesters)
                {
                    <option value="@s"
                            selected="@(Model.SelectedSemester == s ? "selected" : null)">
                        @s
                    </option>
                }
            </select>

            <button type="submit" class="filter-btn">
                Filter
            </button>

        </form>
    </div>

    @* table card *@
    <div class="course-table-card">
        <table class="course-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Faculty</th>
                    <th>Semester</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Courses.Count == 0)
                {
                    <tr>
                        <td colspan="5" style="text-align:center; padding:30px; color:gray;">No courses found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model.Courses)
                    {
                        <tr>
                            <td class="course-code">@c.Code</td>
                            <td class="course-name">@c.Name</td>
                            <td>@c.Faculty</td>
                            <td>@c.Semester</td>
                            <td>
                                <button class="edit-btn"
                                        onclick="openEditModal('@c.Code', '@c.Name', '@c.Faculty', '@c.Semester')">
                                    Edit
                                </button>
                                <button class="delete-btn"
                                        onclick="confirmDelete('@c.Code', '@c.Name')">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* modal: add *@
<div id="addModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
        <h2 class="modal-title">Add Course</h2>
        <form method="post" asp-action="Add" asp-controller="Course">
            @Html.AntiForgeryToken()
            <div class="modal-field">
                <label>Course Code</label>
                <input type="text" name="Code" class="modal-input" required />
            </div>
            <div class="modal-field">
                <label>Course Name</label>
                <input type="text" name="Name" class="modal-input" required />
            </div>
            <div class="modal-field">
                <label>Faculty</label>
                <input type="text" name="Faculty" class="modal-input" required />
            </div>
            <div class="modal-field">
                <label>Semester</label>
                <select name="Semester" class="modal-input">
                    @foreach (var s in Model.Semesters.Where(s => s != "All Semesters"))
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="modal-actions">
                <button type="button" class="modal-cancel-btn" onclick="closeModal('addModal')">Cancel</button>
                <button type="submit" class="modal-submit-btn">Add Course</button>
            </div>
        </form>
    </div>
</div>

@* modal: edit *@
<div id="editModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
        <h2 class="modal-title">Edit Course</h2>
        <form method="post" asp-action="Edit" asp-controller="Course">
            @Html.AntiForgeryToken()
            <div class="modal-field">
                <label>Course Code</label>
                <input type="text" id="editCode" name="Code" class="modal-input" readonly />
            </div>
            <div class="modal-field">
                <label>Course Name</label>
                <input type="text" id="editName" name="Name" class="modal-input" required />
            </div>
            <div class="modal-field">
                <label>Faculty</label>
                <input type="text" id="editFaculty" name="Faculty" class="modal-input" required />
            </div>
            <div class="modal-field">
                <label>Semester</label>
                <select id="editSemester" name="Semester" class="modal-input">
                    @foreach (var s in Model.Semesters.Where(s => s != "All Semesters"))
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="modal-actions">
                <button type="button" class="modal-cancel-btn" onclick="closeModal('editModal')">Cancel</button>
                <button type="submit" class="modal-submit-btn">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@* modal: delete *@
<div id="deleteModal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
        <h2 class="modal-title">Delete Course</h2>
        <p id="deleteMessage" style="margin-bottom:20px; color:#333;"></p>
        <form method="post" asp-action="Delete" asp-controller="Course">
            @Html.AntiForgeryToken()
            <input type="hidden" id="deleteCode" name="code" />
            <div class="modal-actions">
                <button type="button" class="modal-cancel-btn" onclick="closeModal('deleteModal')">Cancel</button>
                <button type="submit" class="modal-delete-btn">Delete</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/Course.js"></script>
}