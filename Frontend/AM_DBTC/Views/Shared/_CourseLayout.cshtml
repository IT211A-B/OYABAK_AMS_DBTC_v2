<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DBTC Attendance</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/Course.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"> 
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="layout-wrapper">

        @* sidebar *@
        <aside class="sidebar">
            <div class="sidebar-menu-label">MENU</div>
            <nav class="sidebar-nav">
                <a href="@Url.Action("AttendanceView", "Attendance")" class="nav-item">
                    <span class="nav-icon"><i class="bi bi-calendar-check"></i></span>
                    Attendance
                </a>
                <a href="@Url.Action("StudentView", "Student")" class="nav-item">
                    <span class="nav-icon"><i class="bi bi-mortarboard"></i></span>
                    Students
                </a>
                <a href="@Url.Action("FacultyView", "Faculty")" class="nav-item">
                    <span class="nav-icon"><i class="bi bi-briefcase"></i></span>
                    Faculty
                </a>
                <a href="@Url.Action("CourseView", "Course")" class="nav-item active">
                    <span class="nav-icon"><i class="bi bi-book"></i></span>
                    Courses
                </a>
            </nav>
            <div class="sidebar-footer">&#169; 2026 DBTC Attendance</div>
        </aside>

        @* main *@
        <div class="main-area">

            @* top header *@
            <header class="topbar">
                <div class="topbar-brand">
                    <div class="brand-icon">&#9881;</div>
                    <div class="brand-text">
                        <strong>DBTC Attendance</strong>
                        <span>Don Bosco Technical College-Cebu</span>
                    </div>
                </div>
            </header>

            @* page content *@
            <main class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>