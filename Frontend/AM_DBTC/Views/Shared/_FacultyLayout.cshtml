<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DBTC Attendance</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/Faculty.css" />
</head>
<body>
    <div class="layout-wrapper">

        <aside class="sidebar">
            <div class="sidebar-menu-label">MENU</div>
            <nav class="sidebar-nav">
                <a href="@Url.Action("AttendanceView", "Attendance")" class="nav-item ">
                    <svg class="nav-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                    Attendance
                </a>
                <a href="@Url.Action("StudentView", "Student")" class="nav-item ">
                    <svg class="nav-icon" viewBox="0 0 24 24"><path d="M22 10v6M2 10l10-5 10 5-10 5-10-5z" /><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5" /></svg>
                    Students
                </a>
                <a href="@Url.Action("FacultyView", "Faculty")" class="nav-item active">
                    <svg class="nav-icon" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
                    Faculty
                </a>
                <a href="@Url.Action("CourseView", "Course")" class="nav-item ">
                    <svg class="nav-icon" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                    Courses
                </a>
            </nav>
            <div class="sidebar-footer">&#169; 2026 DBTC Attendance</div>
        </aside>

        <div class="main-area">
            <header class="topbar">
                <div class="topbar-brand">
                    <div class="brand-logo">&#9881;</div>
                    <div class="brand-text">
                        <strong>DBTC Attendance</strong>
                        <span>Don Bosco Technical College-Cebu</span>
                    </div>
                </div>
            </header>
            <main class="page-content">
                @RenderBody()
            </main>
        </div>

    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
